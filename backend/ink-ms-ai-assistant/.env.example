# Variables de entorno para ink-ms-ai-assistant

# Hugging Face API - OBLIGATORIO para el chatbot
# Obtén tu clave en: https://huggingface.co/settings/tokens
# El token debe tener permiso "Inference Providers"
HUGGINGFACE_API_KEY=
HUGGINGFACE_MODEL=meta-llama/Llama-3.1-8B-Instruct:fastest
HUGGINGFACE_TEMPERATURE=0.7
HUGGINGFACE_MAX_TOKENS=1024
HUGGINGFACE_BASE_URL=https://router.huggingface.co/v1

# MongoDB
MONGODB_URI=mongodb://localhost:27017/ai_chatbot_db

# JWT (debe coincidir con auth service)
JWT_SECRET=inklusport2024superSecretKeyForJWTtokenGenerationWith512bitsAlgorithmHS512
JWT_EXPIRATION=86400000

# Server
SERVER_PORT=3008
LOG_LEVEL=DEBUG
