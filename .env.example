# Inklusport - Variables de entorno
# Copia este archivo como .env en la raíz del proyecto

# JWT (debe coincidir en todos los microservicios)
JWT_SECRET=inklusport2024superSecretKeyForJWTtokenGenerationWith512bitsAlgorithmHS512
JWT_EXPIRATION=86400000

# Google Gemini API - OBLIGATORIO para el chatbot de IA
# Obtén tu clave en: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
GEMINI_TEMPERATURE=0.7
GEMINI_MAX_TOKENS=1024

# Email (auth service)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_PROTOCOL=smtp
MAIL_ENABLED=false
EXPOSE_TOKEN=true
TOKEN_EXPIRY_HOURS=24

# Logging
LOG_LEVEL=INFO

# Circuit breaker
FEIGN_CIRCUITBREAKER=true
